{
  "name": "alpine-js-swiper",
  "version": "1.1.0",
  "description": "Alpine.js plugin for Swiper carousels via x-swiper, $swiper, and x-swiper-event",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "style": "./dist/style.css",
  "unpkg": "./dist/alpine-js-swiper.min.js",
  "jsdelivr": "./dist/alpine-js-swiper.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./cdn": "./dist/alpine-js-swiper.min.js"
  },
  "files": [
    "dist/",
    "index.d.ts",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "keywords": [
    "alpine",
    "alpinejs",
    "alpine.js",
    "swiper",
    "swiperjs",
    "slider",
    "carousel",
    "x-swiper",
    "directive",
    "plugin"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node --test tests/*.test.js && node scripts/test-package.mjs && playwright test",
    "test:unit": "node --test tests/*.test.js",
    "test:package": "node scripts/test-package.mjs",
    "test:browser": "playwright test",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "alpinejs": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "alpinejs": "^3.14.0",
    "esbuild": "^0.25.0",
    "semver": "^7.7.0",
    "swiper": "^12.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Billy Noyes",
  "license": "MIT",
  "homepage": "https://alpine-js-swiper.billynoyes.co.uk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BillyNoyes/alpine-js-swiper.git"
  },
  "bugs": {
    "url": "https://github.com/BillyNoyes/alpine-js-swiper/issues"
  }
}
